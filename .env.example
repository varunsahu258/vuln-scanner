# PostgreSQL connection string used by the API and Celery worker.
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/vuln_scanner
# Redis broker/result-backend URL used by the API and Celery worker.
REDIS_URL=redis://redis:6379/0
# Comma-separated browser origins permitted to call the API.
ALLOWED_ORIGINS=http://localhost:3000
# Maximum scans accepted from one IP address each hour.
RATE_LIMIT_SCAN_PER_HOUR=5
# Maximum read/status requests accepted from one IP address each hour.
RATE_LIMIT_READ_PER_HOUR=60
# API base URL compiled into the Vite frontend.
VITE_API_URL=http://localhost:8000
# Enable canned frontend API responses for standalone UI development.
VITE_MOCK_API=false
# Database name for the self-hosted development/production Postgres container.
POSTGRES_DB=vuln_scanner
# Database username for the self-hosted development/production Postgres container.
POSTGRES_USER=postgres
# Database password for the self-hosted development/production Postgres container; replace in production.
POSTGRES_PASSWORD=postgres
# Pre-built backend image reference used by docker-compose.prod.yml.
BACKEND_IMAGE=ghcr.io/your-org/vuln-scanner-backend:latest
# Pre-built static frontend image reference used by docker-compose.prod.yml.
FRONTEND_IMAGE=ghcr.io/your-org/vuln-scanner-frontend:latest
# Public host port for the production static frontend container.
FRONTEND_PORT=3000
